# Directus CRM - מרכז נשמה / חושן יהודה
# Copy this file to .env and fill in the values
# ==========================================

# Directus API URL (the public URL of your Directus instance)
DIRECTUS_URL=https://crm.merkazneshama.co.il

# Admin API Token (generate from Settings → Access Tokens in Directus)
# Or use a static token set in ADMIN_ACCESS_TOKEN env variable
DIRECTUS_TOKEN=
